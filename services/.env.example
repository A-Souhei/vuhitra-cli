# Environment variables for docker-compose
# Copy this file to .env and update with your values

# PostgreSQL Configuration (REQUIRED - CHANGE_ME)
# WARNING: You MUST change these values before running docker compose!
# Generate a secure password: openssl rand -base64 32
POSTGRES_USER=vuhitra
POSTGRES_PASSWORD=CHANGE_ME_INSECURE_DEFAULT
POSTGRES_DB=vuhitra

# Redis password (REQUIRED - CHANGE_ME)
# WARNING: You MUST change this value before running docker compose!
# Generate a secure password: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_INSECURE_DEFAULT

# Port Mappings (HOST:CONTAINER)
# PostgreSQL port mapping
POSTGRES_HOST_PORT=15432
POSTGRES_CONTAINER_PORT=5432

# Redis port mapping
REDIS_HOST_PORT=16379
REDIS_CONTAINER_PORT=6379

# Sandbox API port mapping
SANDBOX_HOST_PORT=18001
SANDBOX_CONTAINER_PORT=8000

# Transformer service port mapping
TRANSFORMER_HOST_PORT=16050
TRANSFORMER_CONTAINER_PORT=5050

# Elasticsearch port mappings
ELASTICSEARCH_HTTP_HOST_PORT=9200
ELASTICSEARCH_HTTP_CONTAINER_PORT=9200
ELASTICSEARCH_TRANSPORT_HOST_PORT=9300
ELASTICSEARCH_TRANSPORT_CONTAINER_PORT=9300

# Kibana port mapping
KIBANA_HOST_PORT=5601
KIBANA_CONTAINER_PORT=5601

# Spark Master port mappings
SPARK_MASTER_HOST_PORT=7077
SPARK_MASTER_CONTAINER_PORT=7077
SPARK_MASTER_WEBUI_HOST_PORT=8081
SPARK_MASTER_WEBUI_CONTAINER_PORT=8081

# Spark Worker Web UI port
SPARK_WORKER_WEBUI_CONTAINER_PORT=8082

# Ollama port mapping
OLLAMA_HOST_PORT=11434
OLLAMA_CONTAINER_PORT=11434

# Spark Configuration
SPARK_MODE=master
SPARK_RPC_AUTHENTICATION_ENABLED=no
SPARK_RPC_ENCRYPTION_ENABLED=no
SPARK_LOCAL_STORAGE_ENCRYPTION_ENABLED=no
SPARK_SSL_ENABLED=no
SPARK_MASTER_HOST=0.0.0.0
SPARK_MASTER_WEBUI_PORT=${SPARK_MASTER_WEBUI_CONTAINER_PORT}
PYSPARK_PYTHON=python3

# Spark Worker Configuration
SPARK_MASTER_URL=spark://vuhitra-spark-master:${SPARK_MASTER_CONTAINER_PORT}
SPARK_WORKER_WEBUI_PORT=${SPARK_WORKER_WEBUI_CONTAINER_PORT}

# Ollama Configuration (optional - requires --profile ollama)
# Ollama API endpoint (internal network)
OLLAMA_HOST=http://ollama:${OLLAMA_CONTAINER_PORT}
# Default model to use (tinyllama is lightweight and CPU-friendly)
OLLAMA_MODEL=tinyllama
