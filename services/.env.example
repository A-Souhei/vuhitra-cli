# Environment variables for docker-compose
# Copy this file to .env and update with your values

# PostgreSQL Configuration (REQUIRED - CHANGE_ME)
# WARNING: You MUST change these values before running docker compose!
# Generate a secure password: openssl rand -base64 32
POSTGRES_USER=vuhitra
POSTGRES_PASSWORD=CHANGE_ME_INSECURE_DEFAULT
POSTGRES_DB=vuhitra

# Redis password (REQUIRED - CHANGE_ME)
# WARNING: You MUST change this value before running docker compose!
# Generate a secure password: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_INSECURE_DEFAULT

# Spark Configuration
SPARK_MODE=master
SPARK_RPC_AUTHENTICATION_ENABLED=no
SPARK_RPC_ENCRYPTION_ENABLED=no
SPARK_LOCAL_STORAGE_ENCRYPTION_ENABLED=no
SPARK_SSL_ENABLED=no
SPARK_MASTER_HOST=0.0.0.0
SPARK_MASTER_WEBUI_PORT=8081
PYSPARK_PYTHON=python3

# Spark Worker Configuration
SPARK_MASTER_URL=spark://vuhitra-spark-master:7077
SPARK_WORKER_WEBUI_PORT=8082

# Ollama Configuration (optional - requires --profile ollama)
# Ollama API endpoint (internal network)
OLLAMA_HOST=http://ollama:11434
# Default model to use (tinyllama is lightweight and CPU-friendly)
OLLAMA_MODEL=tinyllama
